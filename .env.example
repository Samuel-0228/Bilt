# ─── Bilt Toolkit Environment Configuration ──────────────────────────────────
# Copy this file to .env and adjust variables as needed for your development setup.
# Never commit real credentials, production secrets, or private API keys to this file.
# ─────────────────────────────────────────────────────────────────────────────

# Application port for local test servers / interactive UI (Default: 3000)
PORT=3000

# Node execution environment (development | test | production)
NODE_ENV=development

# Enable internal diagnostic debug logging (1 | true | 0 | false)
BILT_DEBUG=0

# Diagnostic log verbosity level (debug | info | warn | error | silent)
BILT_LOG_LEVEL=info

# Custom Bilt home and cache directory path (Default: ~/.bilt)
# BILT_HOME=~/.bilt

# Active Agent Supervision Session ID (Set automatically by agent supervisory harnesses)
# BILT_SESSION_ID=sess_local_dev

# Active Agent Client identifier (e.g., cursor | claude-code | antigravity)
# BILT_AGENT_NAME=local-agent

# Disable terminal colors and audio bell notifications (1 | true)
# NO_COLOR=1
