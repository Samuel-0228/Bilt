# ─── Bilt Toolkit Environment Configuration ──────────────────────────────────
# Copy this template to .env and adjust variables as needed for your development setup.
# Never commit real credentials, production secrets, or private API keys to this file.
#
# Classification Legend:
#  - Required: Variables that must be present (None: Bilt is zero-config by design).
#  - Optional: Enhances capabilities when configured.
#  - Scope: development-only | CI-only | internal/session state.
#  - Visibility: public/non-secret | secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Core Runtime & Diagnostics (Public / Development-Only) ────────────────
# [Optional] Application port for local test servers / interactive UI (Default: 3000)
PORT=3000

# [Optional] Node execution environment (development | test | production)
NODE_ENV=development

# [Optional] Enable internal diagnostic debug logging (1 | true | 0 | false)
BILT_DEBUG=0

# [Optional] Diagnostic log verbosity level (debug | info | warn | error | silent)
BILT_LOG_LEVEL=info

# [Optional] Disable terminal colors and audio bell notifications (1 | true)
# NO_COLOR=1


# ── 2. AI Provider Integrations (Secret / Optional) ──────────────────────────
# Required ONLY when executing optional AI-assisted commands (e.g., `bilt ask`).
# Safe recommendation: Prefer OS keyring (`bilt ai key set`) over file-based .env.
# Never populate these with live keys in version-controlled repositories.

# [Optional] OpenAI API key for `bilt ask` (Format: sk-...)
# BILT_OPENAI_API_KEY=

# [Optional] Anthropic Claude API key for `bilt ask` (Format: sk-ant-...)
# BILT_ANTHROPIC_API_KEY=

# [Optional] Google Gemini API key for `bilt ask` (Format: AIza...)
# BILT_GEMINI_API_KEY=

# [Optional] OpenRouter unified gateway API key
# BILT_OPENROUTER_API_KEY=

# [Optional] Groq high-speed inference API key
# BILT_GROQ_API_KEY=

# [Optional] Local or self-hosted LLM endpoint authentication key
# BILT_LOCAL_AI_KEY=


# ── 3. Companion Credential Verifiers (Optional / Testing & Validation) ──────
# Used solely by Bilt's offline credential verifier during `bilt scan` to validate
# whether detected AWS credentials belong to an active IAM principal.
# Leave blank unless running explicit live-credential verification in sandbox environments.

# [Optional] Companion AWS Access Key ID (Format: AKIA...) [public/non-secret]
# AWS_ACCESS_KEY_ID=

# [Optional] Companion AWS Secret Access Key [secret]
# AWS_SECRET_ACCESS_KEY=


# ── 4. Internal / Session State & CI Orchestration ───────────────────────────
# Managed automatically by CI pipelines and supervisory agent harnesses.

# [Optional] Custom Bilt home and cache directory path (Default: ~/.bilt)
# BILT_HOME=~/.bilt

# [Optional] Active Agent Supervision Session ID (Set by agent orchestrators)
# BILT_SESSION_ID=sess_local_dev

# [Optional] Active Agent Client identifier (e.g., cursor | claude-code | antigravity)
# BILT_AGENT_NAME=local-agent

# [Optional] CI environment flag (suppresses interactive onboarding in non-TTY runs)
# CI=1


# ── 5. Target Application Reference Patterns (Audited by Bilt) ───────────────
# The variables below represent standard backend secrets that Bilt inspects in user
# codebases during security scans. They are documented here as safe reference examples.
#
# DATABASE_URL=
# JWT_SECRET=
